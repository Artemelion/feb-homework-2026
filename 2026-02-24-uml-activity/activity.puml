@startuml
title Диаграмма деятельности: снятие наличных в банкомате

|Клиент|
start
:Вставить кредитную карточку;
|Банкомат|
:Прочитать идентификатор карточки;
|Банк|
:Проверить карточку;
if (Карточка действительна?) then (нет)
  |Банкомат|
  :Вернуть / заблокировать карточку;
  stop
else (да)
endif
|Банкомат|
:Предложить ввести ПИН-код;
repeat
  |Клиент|
  :Ввести ПИН-код;
  |Банкомат|
  :Проверить ПИН-код;
repeat while (ПИН-код неверный и попыток < 3?) is (да)
-> нет;
if (ПИН-код верный?) then (нет)
  :Заблокировать карточку;
  stop
else (да)
endif
:Показать меню опций;
|Клиент|
:Выбрать снятие наличных;
:Ввести сумму;
|Банк|
:Проверить баланс;
if (Сумма не превышает баланс?) then (да)
  :Уменьшить счет клиента;
else (нет)
  |Банкомат|
  :Сообщить о нехватке средств;
  :Вернуть карточку;
  stop
endif
|Банкомат|
fork
  :Вернуть карточку;
fork again
  if (Нужен чек?) then (да)
    :Распечатать чек;
  else (нет)
  endif
end fork
:Выдать наличные;
|Клиент|
:Забрать карточку и наличные;
|Банкомат|
:Показать сообщение о готовности;
stop
@enduml
