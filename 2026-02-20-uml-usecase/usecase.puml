@startuml
title Диаграмма вариантов использования банкомата
left to right direction

actor "Клиент Банкомата" as Client
actor "Банк" as Bank

rectangle "Банкомат (ATM)" {
  usecase "Снятие наличных\nпо кредитной карточке" as UC1
  usecase "Получение справки\nо балансе" as UC2
  usecase "Проверка кредитной\nкарточки" as UC3
  usecase "Проверка ПИН-кода" as UC4
  usecase "Печать чека" as UC5
  usecase "Блокировка\nкредитной карточки" as UC6
  usecase "Возврат карточки" as UC7
}

Client --> UC1
Client --> UC2
UC1 --> Bank
UC2 --> Bank
UC3 --> Bank

UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>
UC1 ..> UC7 : <<include>>
UC2 ..> UC3 : <<include>>
UC2 ..> UC4 : <<include>>
UC5 ..> UC1 : <<extend>>
UC5 ..> UC2 : <<extend>>
UC6 ..> UC4 : <<extend>>
@enduml
