@startuml
title Система аренды автомобилей - диаграмма состояний договора аренды

[*] --> Создан : бронь подтверждена
state "Создан" as Создан
state "Ожидает оплаты" as Ожидает
state "Активен" as Активен
state "Проверка автомобиля" as Проверка
state "Начисление штрафа" as Штраф
state "Закрыт" as Закрыт
state "Отменён" as Отменён

Создан --> Ожидает : договор подписан
Создан --> Отменён : клиент отказался
Ожидает --> Активен : оплата прошла / выдать ключи
Ожидает --> Отменён : оплата не прошла [3 попытки]
Активен --> Проверка : автомобиль возвращён
Активен --> Активен : продлить аренду / доплата
Проверка --> Закрыт : [повреждений нет]
Проверка --> Штраф : [есть повреждения]
Штраф --> Закрыт : штраф оплачен
Закрыт --> [*]
Отменён --> [*]
@enduml
