@startuml
title Система аренды автомобилей - диаграмма вариантов использования
left to right direction

actor "Клиент" as Client
actor "Менеджер" as Manager
actor "Платёжная система" as Payment

rectangle "Система аренды автомобилей" {
  usecase "Регистрация" as UC1
  usecase "Поиск и выбор\nавтомобиля" as UC2
  usecase "Бронирование\nавтомобиля" as UC3
  usecase "Оформление договора\nаренды" as UC4
  usecase "Оплата аренды" as UC5
  usecase "Возврат автомобиля" as UC6
  usecase "Учёт повреждений" as UC7
  usecase "Оплата штрафа\nза повреждения" as UC8
  usecase "Управление\nавтопарком" as UC9
}

Client --> UC1
Client --> UC2
Client --> UC3
Client --> UC6
Manager --> UC4
Manager --> UC7
Manager --> UC9
UC5 --> Payment
UC8 --> Payment

UC3 ..> UC2 : <<include>>
UC4 ..> UC5 : <<include>>
UC6 ..> UC7 : <<include>>
UC8 ..> UC7 : <<extend>>
@enduml
